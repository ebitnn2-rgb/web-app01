{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "33808419-dad8-4363-a947-e5b3d3da2731","database_name": "web-app00" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9e269b428b734eda95392aef1ad70541" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
